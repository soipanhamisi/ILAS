# Render frontend config
# If frontend and backend are hosted on different domains, set the full backend URL:
# VITE_API_BASE_URL=https://your-backend-service.onrender.com/api
# If you proxy API requests through the same domain, you can keep /api
VITE_API_BASE_URL=/api

# Optional local dev override for Vite proxy target
# VITE_DEV_API_PROXY_TARGET=http://localhost:8081
